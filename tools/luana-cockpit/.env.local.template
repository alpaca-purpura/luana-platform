# Luana Cockpit · variables de entorno
# Copia este archivo a .env.local y completa los valores

# Ruta absoluta al workspace raíz (donde viven vitalia/, nicolify/, etc.)
# Si no se setea, el cockpit usa `git rev-parse --show-toplevel` desde su cwd
WORKSPACE_ROOT=/home/chalreme/Proyectos/luana-protocol-cockpit-v0-6

# Brand por defecto al abrir el cockpit (vitalia | nicolify | comunify | lupulo)
DEFAULT_BRAND=vitalia

# Editor binary que se invoca al hacer "Abrir en editor" desde el cockpit
# Ejemplos: code, cursor, vim, subl
EDITOR_BIN=code

# Puerto del dev server (default 4000)
PORT=4000

# Modo desarrollo: si está activo, expone /api/debug endpoints
NEXT_PUBLIC_DEV_MODE=true
