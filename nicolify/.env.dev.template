# nicolify/.env.dev.template
# CHECKED IN — copialo a nicolify/.env.dev (gitignored) y rellena valores reales.
# nicolify/.env.dev NUNCA debe commitearse (.gitignore ya lo excluye).
#
# S-DOCKER-DEV-MULTIBRAND T-7 — 2026-05-15

# === Clerk (Auth) ===
# Pega valores desde Clerk dashboard → API Keys. Frontend API URL == CLERK_ISSUER.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# CLERK_ISSUER = Frontend API URL — requerido por core/luana-core-iam/application/auth.py (JWT verify)
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# === Database ===
# Host: usar 127.0.0.1 cuando conectas desde el host
# Container: usar luana_postgres_dev cuando conectas desde otro container
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5435/nicolify_dev
# POSTGRES_* requeridos por luana_core_platform Settings (failfast). Valores de CONTAINER
# (el .env.dev se carga via env_file del backend). Host nativo usa DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=nicolify_dev
POSTGRES_HOST=luana_postgres_dev
POSTGRES_PORT=5432
API_URL=http://localhost:8001

# === Redis (DB 0) ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Qdrant ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_URL=http://luana_qdrant_dev:6333
QDRANT_COLLECTION_PREFIX=nicolify_

# === WhatsApp (stub — nicolify aún no usa WhatsApp; Settings los exige) ===
WHATSAPP_API_TOKEN=stub-not-used-nicolify
WHATSAPP_PHONE_NUMBER_ID=stub-not-used-nicolify
WHATSAPP_VERIFY_TOKEN=stub-not-used-nicolify

# === Platform Settings (luana_core_platform failfast — engine-purge defaults) ===
LOG_LEVEL=INFO
DOMAIN_NAME=localhost
TRAEFIK_NETWORK=luana_default
API_SECRET_KEY=REPLACE_ME_GENERATE_WITH_python_-c_secrets.token_urlsafe(32)

# === E2E (Playwright + Clerk) — owner demo sobre tenant "Agencia Demo" ===
# E2E_TENANT_ID = uuid5(6ba7b810-9dad-11d1-80b4-00c04fd430c8, "agencia-demo") determinístico.
# Debe coincidir con nicolify/backend/scripts/seed_test_users_link.py. NO cambiar sin re-seed.
E2E_BASE_URL=http://localhost:3001
E2E_CLERK_USER_EMAIL=owner.demo@nicolify.com
E2E_CLERK_USER_PASSWORD=REPLACE_ME_dev_password
E2E_TENANT_ID=7f464ab7-137b-5e3a-af13-3020aa18814a

# === Brand ===
BRAND_SLUG=nicolify
ENVIRONMENT=development

# === LLM ===
OPENAI_API_KEY=sk-REPLACE_ME
LITELLM_PROXY_URL=http://localhost:4000

# === Brand-specific config (engine consume desde aquí — proposal 2026-05-19) ===
# Post purge nicolify defaults en core/luana-core-platform/core/config.py:
# engine defaults son "" — brand DEBE override aquí (failfast vs silent contamination).
# Estos valores reflejan el comportamiento legacy nicolify (visionarias_ namespace preservado
# por data continuity en Qdrant).
FRONTEND_URL=https://app.nicolify.com
COPILOT_TELEGRAM_BOT_USERNAME=nicolify_copilot_bot
QDRANT_COLLECTION=visionarias_knowledge
QDRANT_COLLECTION_HYBRID=visionarias_hybrid
LITELLM_BASE_URL=http://visionarias_litellm:4000/v1

# === Cloudflared (solo si usas make dev-nicolify-tunnel) ===
# Locally-managed tunnel — el cloudflared container usa
# nicolify/deploy/cloudflared/{dev-config.yml, .credentials/dev-tunnel.json}.
# NO se usa TUNNEL_TOKEN aqui (eso es remotely-managed, mutuamente excluyente).
# Para regenerar el tunnel mira scripts/cloudflared-setup.sh + nicolify/.env.dev.local.

# === Next.js / Frontend ===
# LOCAL access (puerto 3001 directo): NEXT_PUBLIC_API_URL apunta a backend localhost.
# TUNNEL access (dev-app.nicolify.com): descomentar bloque tunnel + comentar local.
NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_APP_URL=https://dev-app.nicolify.com
# NEXT_PUBLIC_API_URL=https://dev-app.nicolify.com
INTERNAL_API_URL=http://nicolify_backend_dev:8001
# CLERK_DOMAIN=dev-app.nicolify.com

# === Ports (referencia — definidos en compose file) ===
# Backend: 8001
# Frontend: 3001
