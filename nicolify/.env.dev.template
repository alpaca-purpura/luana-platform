# === Clerk (Auth) ===
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# === Database ===
# Host: usar 127.0.0.1 cuando conectas desde el host
# Container: usar luana_postgres_dev cuando conectas desde otro container
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5435/nicolify_dev

# === Redis (DB 0) ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Qdrant ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=nicolify_

# === Brand ===
BRAND_SLUG=nicolify
ENVIRONMENT=development

# === LLM ===
OPENAI_API_KEY=sk-REPLACE_ME
LITELLM_PROXY_URL=http://localhost:4000

# === Cloudflared (solo si usas make dev-nicolify-tunnel) ===
TUNNEL_TOKEN=REPLACE_ME_IF_USING_TUNNEL

# === Next.js ===
NEXT_PUBLIC_API_URL=http://localhost:8001

# === Ports (referencia — definidos en compose file) ===
