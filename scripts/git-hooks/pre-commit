  V4_STATES_REGEX='^state:[[:space:]]*(idea|refining|refined|ready|developing|developed|reviewing|done|parked|dropped|blocked)\b'
  STATE_VIOLATIONS=""

  while IFS= read -r FILE; do
    [ -z "${FILE}" ] && continue
    [ ! -f "${FILE}" ] && continue
    # Bypass via magic comment
    if grep -qE '<!--[[:space:]]*state-enum-na' "${FILE}"; then
