# S-DOCKER-DEV-MULTIBRAND T-7 — 2026-05-15

# === Clerk (Auth) ===
# Pega valores desde Clerk dashboard → API Keys. Frontend API URL == CLERK_ISSUER.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# CLERK_ISSUER = Frontend API URL — requerido por core/luana-core-iam/application/auth.py (JWT verify)
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5435/comunify_dev

# === Redis (DB 2) ===
REDIS_URL=redis://127.0.0.1:6379/2

# === Qdrant ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=comunify_

# === Brand ===
BRAND_SLUG=comunify
ENVIRONMENT=development

# === LLM ===
OPENAI_API_KEY=sk-REPLACE_ME
LITELLM_PROXY_URL=http://localhost:4000

# === Brand-specific config (engine consume desde aquí — proposal 2026-05-19) ===
# Post purge nicolify defaults en core/luana-core-platform/core/config.py:
# engine defaults son "" — brand DEBE override aquí (failfast vs silent contamination).
FRONTEND_URL=https://dev-app.comunifyagents.com
COPILOT_TELEGRAM_BOT_USERNAME=comunify_copilot_bot
QDRANT_COLLECTION=comunify_knowledge
QDRANT_COLLECTION_HYBRID=comunify_hybrid
LITELLM_BASE_URL=http://localhost:4000/v1

# === Cloudflared (solo si usas make dev-comunify-tunnel) ===
# Locally-managed tunnel — el cloudflared container usa
# comunify/deploy/cloudflared/{dev-config.yml, .credentials/dev-tunnel.json}.
# NO se usa TUNNEL_TOKEN aqui (eso es remotely-managed, mutuamente excluyente).
# Dominio dev: dev-app.comunifyagents.com.

# === Next.js / Frontend ===
# LOCAL access (puerto 3003 directo): NEXT_PUBLIC_API_URL apunta a backend localhost.
# TUNNEL access (dev-app.comunifyagents.com): descomentar bloque tunnel + comentar local.
NEXT_PUBLIC_API_URL=http://localhost:8003
# NEXT_PUBLIC_APP_URL=https://dev-app.comunifyagents.com
# NEXT_PUBLIC_API_URL=https://dev-app.comunifyagents.com
INTERNAL_API_URL=http://comunify_backend_dev:8003
# CLERK_DOMAIN=dev-app.comunifyagents.com

# === Ports (referencia — definidos en compose file) ===
# Backend: 8003
# Frontend: 3003

# === E2E (Playwright authed shell-organism · T-e2e) ===
# Consumidos por comunify/frontend/playwright.config.ts (dotenv) + e2e/setup/clerk.setup.ts.
# Ticket strategy (clerk.signIn): usa el email + CLERK_SECRET_KEY (sin password).
E2E_BASE_URL=http://localhost:3003
E2E_CLERK_USER_EMAIL=tu-usuario-de-prueba@example.com
E2E_TENANT_ID=comunify-demo
