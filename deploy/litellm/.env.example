# deploy/litellm/.env — provider keys for the shared dev LLM gateway.
# Copy to deploy/litellm/.env (gitignored) and fill with real DEV keys.
# NEVER commit the real .env. Chinese-first: DeepSeek + Moonshot are required;
# OpenAI is the exception (embeddings + rare high-need).

DEEPSEEK_API_KEY=sk-REPLACE_ME
MOONSHOT_API_KEY=sk-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
LITELLM_MASTER_KEY=sk-litellm-master-dev
